<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="PokeDaisy.UwpHost" Publisher="CN=PokeDaisyHost" Version="1.0.0.28" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>PokeDaisy UWP</DisplayName>
    <PublisherDisplayName>PokeDaisy</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Capabilities>
    <!-- A ROM folder or save folder on a USB drive: the host reads it with the ...FromApp file calls, and this capability
         lets the package reach the user's files. On Xbox Dev Mode the ...FromApp calls work; FolderPicker does not, which
         is why the host has its own folder browser. runFullTrust is what Xbox ports that read a folder this way ship. -->
    <rescap:Capability Name="broadFileSystemAccess" />
    <rescap:Capability Name="runFullTrust" />
    <!-- RetroAchievements: rc_client's server calls through WinHTTP. -->
    <Capability Name="internetClient" />
  </Capabilities>
  <Applications>
    <Application Id="App" Executable="PokeDaisy.exe" EntryPoint="Windows.FrameWork.Application">
      <uap:VisualElements
        DisplayName="PokeDaisy"
        Description="PokeDaisy SDL host for Windows and Xbox"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
